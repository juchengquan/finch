{
  "sourceLanguage": "en",
  "strings": {
    "0": {},
    "12": {},
    " saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 已存"
          }
        }
      }
    },
    " · %lld days left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 剩余 %lld 天"
          }
        }
      }
    },
    "\"Saved so far\" is money set aside before tracking began. Matching transactions add on top of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“已存金额”是开始跟踪前预留的金额。匹配的交易会在此基础上累加。"
          }
        }
      }
    },
    "%@": {},
    "%@ (%@) looks higher than usual.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）高于平常。"
          }
        }
      }
    },
    "%@ / %@": {},
    "%@ is %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 余额为 %2$@。"
          }
        }
      }
    },
    "%@ is due. Confirm now?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已到期。立即确认？"
          }
        }
